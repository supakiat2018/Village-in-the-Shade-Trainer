    <CheatEntry>
      <ID>31</ID>
      <Description>"🔄 ความเร็วปกติ 1.0x (Normal Speed) [ปุ่ม Num +]"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
