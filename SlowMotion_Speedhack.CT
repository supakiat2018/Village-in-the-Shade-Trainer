    <CheatEntry>
      <ID>11</ID>
      <Description>"⚡ เร่งความเร็ว 2x (เร็วขึ้น 2 เท่า)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if speedhack_setSpeed then speedhack_setSpeed(2.0) end
{$asm}

[DISABLE]
{$lua}
if speedhack_setSpeed then speedhack_setSpeed(1.0) end
{$asm}
</AssemblerScript>
