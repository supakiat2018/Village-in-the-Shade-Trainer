  </CheatEntries>
  <LuaScript>
local processName = "village.exe"
openProcess(processName)

local speed_mem = allocateMemory(4)
registerSymbol("vits_custom_speed", speed_mem)
writeFloat(speed_mem, 1.0)

local last_custom_speed = 1.0
local speed_timer = createTimer(nil)
timer_setInterval(speed_timer, 250)
timer_onTimer(speed_timer, function()
  local cur = readFloat(speed_mem)
  if cur and cur > 0 and math.abs(cur - last_custom_speed) > 0.001 then
    last_custom_speed = cur
    if speedhack_setSpeed then
      speedhack_setSpeed(cur)
    end
  end
end)
  </LuaScript>
</CheatTable>
