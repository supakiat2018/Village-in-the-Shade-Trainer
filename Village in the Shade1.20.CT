  </CheatEntries>
  <LuaScript>local GETTER_SIG =
  "48 8B 05 ?? ?? ?? ?? 48 8B 6C 24 38 48 8B 74 24 40 49 8B 50 10 " ..
  "48 8B 88 08 02 00 00 48 8B 7C 24 48 48 8B 81 "

local function scanOne(sig)
  local list = AOBScan(sig)
  if list == nil then return nil end
  local addr = nil
  if list.getCount() == 1 then addr = tonumber(list[0], 16) end
  list.destroy()
  return addr
end

function vitsResolve()
  local modbase = getAddress("village.exe")
  if modbase == nil or modbase == 0 then
    print("[vits] not attached to village.exe - attach first, then run this again")
    return
  end

  local site = scanOne(GETTER_SIG .. "70 32 00 00")
  if site == nil then
    print("[vits] time getter signature not found, or not unique")
    return
  end

  local global = site + 7 + readInteger(site + 3)
  print(string.format("[vits] Address field should be:  \"village.exe\"+%X", global - modbase))
  print(string.format("[vits] time member offset  = %X", readInteger(site + 36)))

  local msite = scanOne(GETTER_SIG .. "A0 32 00 00")
  if msite ~= nil then
    print(string.format("[vits] money member offset = %X", readInteger(msite + 36)))
  end

  local state = readPointer(readPointer(global) + 0x208)
  if state == nil or state == 0 then
    print("[vits] state object is null - load a save, then run this again")
  else
    local status = readPointer(state + 0x32B8)
    print(string.format("[vits] state = %X   time = %d   money = %d",
          state, readQword(state + 0x3270), readQword(state + 0x32A0)))
    if status ~= nil and status ~= 0 then
      print(string.format("[vits] ST = %d / %d",
            readInteger(status + 0x398), readInteger(status + 0x3A4)))
    end
  end
end

local VITS_GI      = "village.exe+10FCBB0"
local VITS_SAVE    = 0x208
local VITS_INV     = 0x32C0
local VITS_INVMAX  = 30
local VITS_SEL     = 0x33B0
local VITS_TOOL    = 0x33B8
local VITS_TOOLMAX = 10
local VITS_HANDLE  = 0x240
local VITS_COUNT   = 0x260
local VITS_NAMEBUF = 128

local VITS_LANGS = {
  { 0x40, "Japanese" },
  { 0x48, "English"  },
  { 0x50, "French"   },
  { 0x58, "Spanish"  },
  { 0x60, "Chinese"  },
  { 0x68, "Korean"   },
}
local VITS_LANGNAME = {}
for _, e in ipairs(VITS_LANGS) do VITS_LANGNAME[e[1]] = e[2] end

vitsLangCur = vitsLangCur or 0x48

vitsItemIndex = nil
vitsSelTimer  = nil
vitsMem       = nil

local nameCache = {}
local idShadow  = {}

local VITS_LAYOUT = {
  { "vitsSelItem",   0x0000 },
  { "vitsSelID",     0x0008 },
  { "vitsSelName",   0x0010 },
  { "vitsInvNames",  0x0090 },
  { "vitsInvIDs",    0x0F90 },
  { "vitsLang",      0x1010 },
}
local OFF_SELID, OFF_SELNAME = 0x0008, 0x0010
local OFF_NAMES, OFF_IDS, OFF_LANG = 0x0090, 0x0F90, 0x1010

local function setStatus(msg)
  print("[vits] " .. msg)
end

function vitsSaveData()
  local gi = readPointer(VITS_GI)
  if gi == nil or gi == 0 then return nil end
  local sd = readPointer(gi + VITS_SAVE)
  if sd == nil or sd == 0 then return nil end
  return sd
end

local function utf8ToUtf16(s)
  local out, i, n = {}, 1, #s
  while i &lt;= n and #out &lt; VITS_NAMEBUF - 2 do
    local c = s:byte(i)
    local cp, len
    if c &lt; 0x80 then cp, len = c, 1
    elseif c &lt; 0xE0 then cp, len = c - 0xC0, 2
    elseif c &lt; 0xF0 then cp, len = c - 0xE0, 3
    else cp, len = c - 0xF0, 4 end
    if i + len - 1 &gt; n then break end
    for k = 1, len - 1 do
      local b = s:byte(i + k)
      if b == nil or b &lt; 0x80 then return out end
      cp = cp * 64 + (b - 0x80)
    end
    i = i + len
    if cp &lt; 0x10000 then
      out[#out + 1] = cp % 256
      out[#out + 1] = math.floor(cp / 256)
    else
      cp = cp - 0x10000
      local hi, lo = 0xD800 + math.floor(cp / 0x400), 0xDC00 + (cp % 0x400)
      out[#out + 1] = hi % 256
      out[#out + 1] = math.floor(hi / 256)
      out[#out + 1] = lo % 256
      out[#out + 1] = math.floor(lo / 256)
    end
  end
  return out
end

local function writeUtf16(buf, s)
  local bytes = utf8ToUtf16(s or "")
  bytes[#bytes + 1] = 0
  bytes[#bytes + 1] = 0
  writeBytes(buf, bytes)
end

local function vitsSeedHandle(sd)
  for _, a in ipairs({ { VITS_INV, VITS_INVMAX }, { VITS_TOOL, VITS_TOOLMAX } }) do
    for i = 0, a[2] - 1 do
      local p = readPointer(sd + a[1] + i * 8)
      if p ~= nil and p ~= 0 then
        local h = readPointer(p + VITS_HANDLE)
        if h ~= nil and h ~= 0 then return h end
      end
    end
  end
  return nil
end

function vitsBuildItemIndex()
  local sd = vitsSaveData()
  if sd == nil then return nil end
  local seed = vitsSeedHandle(sd)
  if seed == nil then
    print("[vits] you hold no items, so the item database cannot be walked")
    return nil
  end

  local first = seed - 0x18
  local node, map, n = first, {}, 0
  repeat
    local key = readQword(node + 0x10)
    local val = readQword(node + 0x18)
    if key ~= nil and val ~= nil and val ~= 0 and key &gt; 0 and key &lt; 10000000 then
      if readQword(val) == key then map[key] = node + 0x18 end
    end
    local nxt = readQword(node)
    if nxt == nil or nxt == 0 then break end
    node = nxt
    n = n + 1
  until node == first or n &gt; 30000

  vitsItemIndex = map
  return map
end

local function handleValid(h, id)
  if h == nil then return false end
  local rec = readQword(h)
  return rec ~= nil and rec ~= 0 and readQword(rec) == id
end

function vitsItemHandle(id)
  local h = vitsItemIndex and vitsItemIndex[id]
  if handleValid(h, id) then return h end
  vitsBuildItemIndex()
  h = vitsItemIndex and vitsItemIndex[id]
  if handleValid(h, id) then return h end
  return nil
end

local function nameOfHandle(h)
  if h == nil or h == 0 then return nil end
  local rec = readQword(h)
  if rec == nil or rec == 0 then return nil end
  local p = readQword(rec + vitsLangCur)
  if p == nil or p == 0 then return nil end
  local s = readString(p, 48, false)
  if s == nil or s == "" then return nil end
  return s
end

function vitsItemName(id)
  return nameOfHandle(vitsItemHandle(id))
end

local function langCoverage(limit)
  if vitsItemIndex == nil then return 0, 0 end
  local seen, named = 0, 0
  for _, h in pairs(vitsItemIndex) do
    seen = seen + 1
    if nameOfHandle(h) ~= nil then named = named + 1 end
    if seen &gt;= limit then break end
  end
  return named, seen
end

function vitsLangReport()
  if vitsItemIndex == nil and vitsBuildItemIndex() == nil then return end
  local save = vitsLangCur
  for _, e in ipairs(VITS_LANGS) do
    vitsLangCur = e[1]
    local named, seen = langCoverage(100000)
    print(string.format("[vits] +%02X  %-9s  %d / %d named", e[1], e[2], named, seen))
  end
  vitsLangCur = save
end

function vitsNameScan(id)
  if vitsItemIndex == nil and vitsBuildItemIndex() == nil then return end
  local h = id and vitsItemHandle(id) or nil
  if h == nil then
    local best = nil
    for k, v in pairs(vitsItemIndex) do
      if best == nil or k &lt; best then best, h = k, v end
    end
    id = best
  end
  if h == nil then return end
  local rec = readQword(h)
  if rec == nil or rec == 0 then return end
  print(string.format("[vits] item %d, record %X", id, rec))
  for off = 0, 0xF8, 8 do
    local p = readQword(rec + off)
    if p ~= nil and p &gt; 0x10000 then
      local s = readString(p, 48, false)
      if s ~= nil and s ~= "" then
        print(string.format("[vits] +%02X  %s", off, s))
      end
    end
  end
end

local function applyLang(off, announce)
  vitsLangCur = off
  nameCache = {}
  local named, seen = langCoverage(200)
  if seen &gt; 0 and named == 0 then
    setStatus(string.format("%s (+%02X) names are not in this build",
                            VITS_LANGNAME[off], off))
  elseif announce then
    setStatus(string.format("item names: %s (+%02X)", VITS_LANGNAME[off], off))
  end
  vitsFillDropdowns()
end

local function pollLang()
  local want = readInteger(vitsMem + OFF_LANG)
  if want == nil or want == vitsLangCur then return end
  if VITS_LANGNAME[want] == nil then
    writeInteger(vitsMem + OFF_LANG, vitsLangCur)
    return
  end
  applyLang(want, true)
end

local function itemHandleOf(item)
  if item == nil or item == 0 then return 0 end
  return readPointer(item + VITS_HANDLE) or 0
end

local function itemIdOf(item)
  local h = itemHandleOf(item)
  if h == 0 then return 0 end
  local rec = readQword(h)
  if rec == nil or rec == 0 then return 0 end
  return readQword(rec) or 0
end

function vitsItemList(filter)
  if vitsItemIndex == nil and vitsBuildItemIndex() == nil then return end
  local ids = {}
  for id, _ in pairs(vitsItemIndex) do ids[#ids + 1] = id end
  table.sort(ids)
  local n = 0
  for _, id in ipairs(ids) do
    local nm = nameOfHandle(vitsItemIndex[id]) or ""
    if filter == nil or string.find(nm, filter, 1, true) then
      print(string.format("%7d  %s", id, nm))
      n = n + 1
    end
  end
  print(string.format("[vits] %d items", n))
end

function vitsFillDropdowns()
  if vitsItemIndex == nil and vitsBuildItemIndex() == nil then
    print("[vits] item database unreadable, no drop-down built (load a save first)")
    return 0
  end
  local ids = {}
  for id, _ in pairs(vitsItemIndex) do ids[#ids + 1] = id end
  table.sort(ids)
  local lines = {}
  for _, id in ipairs(ids) do
    lines[#lines + 1] = string.format("%d:%s", id, nameOfHandle(vitsItemIndex[id]) or "")
  end
  local text = table.concat(lines, "\n")

  local al = getAddressList()
  local n = 0
  for i = 0, al.Count - 1 do
    local mr = al.getMemoryRecord(i)
    local d = mr.Description
    if d ~= nil and string.find(d, "Item ID", 1, true) ~= nil then
      local ok = pcall(function()
        mr.DropDownList.Text = text
        mr.DropDownReadOnly = false
        mr.DropDownDescriptionOnly = false
        mr.DisplayAsDropDownListItem = false
      end)
      if ok then n = n + 1 end
    end
  end
  print(string.format("[vits] %d items loaded into %d drop-downs", #ids, n))
  return n
end

local function refreshName(buf, item)
  local h = itemHandleOf(item)
  if nameCache[buf] == h then return end
  nameCache[buf] = h
  writeUtf16(buf, nameOfHandle(h ~= 0 and h or nil) or "")
end

local function syncId(buf, item, slot)
  local actual = itemIdOf(item)
  local cur = readInteger(buf)
  if cur == nil then return end

  local known = idShadow[buf]
  if known ~= nil and cur ~= known then
    if cur ~= 0 then
      if item == 0 then
        setStatus("slot " .. slot .. " is empty, nothing to replace")
      else
        local h = vitsItemHandle(cur)
        if h == nil then
          setStatus("id " .. cur .. " is not in the item database")
        else
          writeQword(item + VITS_HANDLE, h)
          nameCache = {}
          setStatus(string.format("slot %d: %s -&gt; %s (x%d)", slot,
                    vitsItemName(actual) or tostring(actual),
                    nameOfHandle(h) or tostring(cur),
                    readInteger(item + VITS_COUNT) or 0))
          actual = itemIdOf(item)
        end
      end
    end
  elseif known ~= nil and cur == actual then
    return
  end

  writeInteger(buf, actual)
  idShadow[buf] = actual
end

function vitsSelTick()
  if vitsMem == nil then return end
  pollLang()
  local sd = vitsSaveData()
  if sd == nil then
    writeQword(vitsMem, 0)
    return
  end

  local slot = readInteger(sd + VITS_SEL) or 0
  local item = 0
  if slot &gt;= 0 and slot &lt; VITS_INVMAX then
    item = readPointer(sd + VITS_INV + slot * 8) or 0
  end
  writeQword(vitsMem, item)
  refreshName(vitsMem + OFF_SELNAME, item)
  syncId(vitsMem + OFF_SELID, item, slot)

  for i = 0, VITS_INVMAX - 1 do
    local p = readPointer(sd + VITS_INV + i * 8) or 0
    refreshName(vitsMem + OFF_NAMES + i * VITS_NAMEBUF, p)
    syncId(vitsMem + OFF_IDS + i * 4, p, i)
  end
end

function vitsSelStart()
  nameCache = {}
  idShadow = {}

  if vitsMem == nil or vitsMem == 0 then
    vitsMem = allocateMemory(8192)
    if vitsMem == nil or vitsMem == 0 then
      error("could not allocate memory (are you attached to village.exe?)")
    end
  end
  for _, e in ipairs(VITS_LAYOUT) do
    registerSymbol(e[1], vitsMem + e[2], true)
  end
  writeQword(vitsMem, 0)
  writeInteger(vitsMem + OFF_LANG, vitsLangCur)

  vitsBuildItemIndex()
  applyLang(vitsLangCur, false)

  if vitsSelTimer == nil then
    vitsSelTimer = createTimer(nil)
    timer_setInterval(vitsSelTimer, 100)
    timer_onTimer(vitsSelTimer, vitsSelTick)
  end
  timer_setEnabled(vitsSelTimer, true)
end

function vitsSelStop()
  if vitsSelTimer ~= nil then
    timer_setEnabled(vitsSelTimer, false)
    object_destroy(vitsSelTimer)
    vitsSelTimer = nil
  end
  for _, e in ipairs(VITS_LAYOUT) do
    unregisterSymbol(e[1])
  end
  if vitsMem ~= nil and vitsMem ~= 0 then
    deAlloc(vitsMem)
    vitsMem = nil
  end
  vitsItemIndex = nil
  nameCache = {}
  idShadow = {}
end
</LuaScript>
</CheatTable>
