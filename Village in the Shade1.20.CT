              <CheatEntries>
                <CheatEntry>
                  <ID>139</ID>
                  <Description>"├ Name"</Description>
                  <ShowAsHex>0</ShowAsHex>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>String</VariableType>
                  <Length>48</Length>
                  <Unicode>1</Unicode>
                  <CodePage>0</CodePage>
                  <ZeroTerminate>1</ZeroTerminate>
                  <Address>vitsInvNames+E80</Address>
                </CheatEntry>
                <CheatEntry>
                  <ID>140</ID>
                  <Description>"├ Stack Count"</Description>
                  <ShowAsHex>0</ShowAsHex>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>4 Bytes</VariableType>
                  <Address>"village.exe"+10FCBB0</Address>
                  <Offsets>
                    <Offset>260</Offset>
                    <Offset>33A8</Offset>
                    <Offset>208</Offset>
                  </Offsets>
                </CheatEntry>
                <CheatEntry>
                  <ID>141</ID>
                  <Description>"└ Item ID (Dropdown)"</Description>
                  <ShowAsHex>0</ShowAsHex>
                  <ShowAsSigned>0</ShowAsSigned>
                  <VariableType>4 Bytes</VariableType>
                  <Address>vitsInvIDs+74</Address>
